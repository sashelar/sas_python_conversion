def demo_dataframe_comparison():
    """
    Complete demo showing how to create test data and introduce differences
    """
    from pyspark.sql import Row
    
    # Create original DataFrame with 3 column types
    original_data = [
        Row(id="CUST001", name="John Smith", salary=50000.00),
        Row(id="CUST002", name="Jane Doe", salary=55000.50),
        Row(id="CUST003", name="Bob Johnson", salary=60000.75),
        Row(id="CUST004", name="Alice Williams", salary=45000.25),
        Row(id="CUST005", name="Charlie Brown", salary=52000.00),
        Row(id="CUST006", name="David Miller", salary=58000.50),
        Row(id="CUST007", name="Emma Davis", salary=61000.00),
        Row(id="CUST008", name="Frank Wilson", salary=48000.75),
        Row(id="CUST009", name="Grace Lee", salary=53000.25),
        Row(id="CUST010", name="Henry Taylor", salary=57000.00),
    ]
    
    df1 = spark.createDataFrame(original_data)
    
    print("=" * 80)
    print("ORIGINAL DATAFRAME (DF1)")
    print("=" * 80)
    df1.show(10, truncate=False)
    
    # Introduce controlled differences
    modifications = {
        'id': {
            'type': 'alphanumeric',
            'change_percent': 20,  # Change 20% of IDs
            'change_type': 'number_change'  # CUST001 -> CUST002
        },
        'name': {
            'type': 'alpha',
            'change_percent': 30,  # Change 30% of names
            'change_type': 'typo'  # Smith -> Smyth
        },
        'salary': {
            'type': 'numeric',
            'change_percent': 40,  # Change 40% of salaries
            'change_type': 'decimal'  # 50000.00 -> 50000.01
        }
    }
    
    df2 = introduce_differences(df1, modifications)
    
    print("\n" + "=" * 80)
    print("MODIFIED DATAFRAME (DF2) - WITH INTRODUCED DIFFERENCES")
    print("=" * 80)
    df2.show(10, truncate=False)
    
    # Now run the comparison
    print("\n" + "=" * 80)
    print("RUNNING COMPARISON...")
    print("=" * 80)
    
    comparator = DataFrameComparator(
        spark=spark,
        df1=df1,
        df2=df2,
        key_columns=['id'],
        numeric_precision=2,
        fuzzy_threshold=0.85
    )
    
    report = comparator.compare()
    
    # Show detailed report
    print("\n" + comparator.get_detailed_report())
    
    # Show specific column differences
    print("\n" + "=" * 80)
    print("DETAILED DIFFERENCES BY COLUMN")
    print("=" * 80)
    
    if 'data_comparison' in report:
        for col_name, details in report['data_comparison']['column_details'].items():
            if not details['all_values_match']:
                print(f"\n❌ Column: {col_name}")
                print(f"   Type: {details['comparison_type']}")
                print(f"   Match: {details['match_percentage']}%")
                
                if 'sample_mismatches' in details and details['sample_mismatches']:
                    print(f"   Sample differences:")
                    for i, sample in enumerate(details['sample_mismatches'][:3], 1):
                        if details['comparison_type'] == 'numeric':
                            print(f"   {i}. DF1: {sample['df1_value']} → DF2: {sample['df2_value']} (Diff: {sample['difference']})")
                        else:
                            print(f"   {i}. DF1: '{sample['df1_value']}' → DF2: '{sample['df2_value']}' (Score: {sample.get('fuzzy_score', 'N/A')})")
    
    return df1, df2, report


