    from Limits_Issuer_UltimateParent a
    left outer join ultimate_parent_limits b
    on a.Ultimate_Parent_Risk = b.Ultimate_Parent_Risk
""")

Limits_Issuer_UltimateParent = Limits_Issuer_UltimateParent.withColumn(
