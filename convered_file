Limits_by_Country = spark.sql("""
    select reporting_date, Entity_ID, Isin_agr, Country_of_Risk, Country_lmt, business_model,
            sum(Accouting_Val_IFRS_Accrued_Incl) as book_value,
            sum(Investment_SII_Value) as market_value
    from AssetDBEntry_Conso_enriched
    group by 1,2,3,4,5,6
    having Country_of_Risk is not null and Entity_ID = 'CONSO'
""")

Limits_by_Country = Limits_by_Country.withColumn(
    "amount",
    F.when(F.col("business_model").isin(["AC"]), F.col("book_value"))
     .otherwise(F.col("market_value"))
)
Limits_by_Country.createOrReplaceTempView("Limits_by_Country")

Limits_by_Country = spark.sql("""
    select reporting_date, Entity_ID, Country_of_Risk, Country_lmt, sum(amount) as total_amount
    from Limits_by_Country
    group by 1,2,3,4
""")

Limits_by_Country = Limits_by_Country.withColumn(
    "limit_breach",
    F.when((F.col("total_amount") > F.col("Country_lmt")) &
           (~F.col("Country_of_Risk").isin(["BELGIUM", "EUROPE"])), F.lit("YES"))
     .otherwise(F.lit("NO"))
)
Limits_by_Country.write.mode("overwrite").saveAsTable("OUT_LM.Limits_by_Country")


