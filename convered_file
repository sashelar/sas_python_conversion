ultimate_parent_limits = spark.sql("""
    select distinct Ultimate_Parent_Risk
    from ultimate_parent_limits
""")
ultimate_parent_limits.createOrReplaceTempView("ultimate_parent_limits")

Limits_Issuer_UltimateParent = spark.sql("""
