# -------------------------------------------------------------------------------------
# Create Illiquid Assets Table
# -------------------------------------------------------------------------------------
illiquid_assets = spark.sql("""
    select Entity_ID, Instrument_lmt, sum(Investment_SII_Value)/1000000 as Market_Value
    from AssetDBEntry_Conso_enriched
    where Instrument_lmt in ('Properties','Loans & mortgages to individuals','Strategic Participation Part','Equities-unlisted')
    group by 1,2
""")

equities_illiquid = spark.sql("""
    select Entity_ID, liquidity_assessment as Instrument_lmt, SDT_Value as Market_Value
    from SDT_LISTED
    where liquidity_assessment = 'Illiquid'
""")

illiquid = illiquid_assets.unionByName(equities_illiquid)
illiquid = illiquid.withColumn(
    "category",
    F.when(F.col("Instrument_lmt") == "Illiquid", F.lit("Equities - listed with SDT > 7days"))
     .otherwise(F.col("Instrument_lmt"))
).drop("Instrument_lmt")

bond_lending = spark.sql("""
    select Entity_ID, sum(Investment_SII_Value)/1000000 as Bond_lending
    from AssetDBEntry_Conso_enriched
    where Solvency_alt_act_descr in ('Government Bonds')
    and affectation like '%LENDING%'
    group by 1
""")

Instrument_illiquid = spark.sql("""
    select Entity_ID, sum(Investment_SII_Value)/1000000 as Instrument_Illiquid
    from AssetDBEntry_Conso_enriched
    where Instrument_lmt in ('Bonds Part')
    and Liquidity_Assessment = 'Illiquid'
    group by 1
""")

Other_loans = spark.sql("""
    select Entity_ID, sum(Investment_SII_Value)/1000000 as Other_loans
    from AssetDBEntry_Conso_enriched
    where (Instrument_lmt in ('Loans Part') and Liquidity_Assessment = 'Illiquid')
    or (Instrument_lmt in ('Loans on policies'))
    group by 1
""")

Investment_funds = spark.sql("""
    select Entity_ID, sum(Investment_SII_Value)/1000000 as Investment_funds
    from AssetDBEntry_Conso_enriched
    where Instrument_lmt in ('Investment Funds Bonds Part', 'Investment Funds Shares Part')
    and Liquidity_Assessment = 'Illiquid'
    group by 1
""")

# proc means (class ENTITY_ID MAGNITUDE_ACCOUNT_5POS Instrument_Type) + keep non missing class values
Reverse_repos = spark.sql("""
    select Entity_ID, MAGNITUDE_ACCOUNT_5POS, Instrument_Type,
            sum(ASSET_MASTER_MARKETVAL_ACC_INC) as ASSET_MASTER_MARKETVAL_ACC_INC
    from AssetDBEntry_Conso_enriched
    where Instrument_Type in ('Repos', 'Reverse Repos')
    group by 1,2,3
    having MAGNITUDE_ACCOUNT_5POS is not null and Instrument_Type is not null
""")

nobs = Reverse_repos.count()

if nobs != 0:
    # proc transpose by Magnitude_account_5pos -> Repos / Reverse_repos
    Reverse_repos_tr = (Reverse_repos.groupBy("MAGNITUDE_ACCOUNT_5POS")
                        .pivot("Instrument_Type", ["Repos", "Reverse Repos"])
                        .agg(F.sum("ASSET_MASTER_MARKETVAL_ACC_INC"))
                        .withColumnRenamed("Reverse Repos", "Reverse_repos"))
    # sum(Reverse_repos, -Repos) -> missing values are ignored
    Reverse_repos = Reverse_repos_tr.select(
        F.col("MAGNITUDE_ACCOUNT_5POS"),
        ((F.coalesce(F.col("Reverse_repos"), F.lit(0)) - F.coalesce(F.col("Repos"), F.lit(0))) / 1000000).alias("Repo")
    )

    illiquid_tot = (bond_lending
                    .join(Instrument_illiquid, "Entity_ID", "full_outer")
                    .join(Other_loans, "Entity_ID", "full_outer")
                    .join(Investment_funds, "Entity_ID", "full_outer"))
    # SAS merge without BY = one to one merge (by observation number)
    illiquid_tot = illiquid_tot.withColumn("_row", F.row_number().over(Window.orderBy("Entity_ID")))
    Reverse_repos_pos = (Reverse_repos
                         .withColumn("_row", F.row_number().over(Window.orderBy("MAGNITUDE_ACCOUNT_5POS")))
                         .select("_row", "Repo"))
    illiquid_tot = illiquid_tot.join(Reverse_repos_pos, "_row", "left").drop("_row")
else:
    illiquid_tot = (bond_lending
                    .join(Instrument_illiquid, "Entity_ID", "full_outer")
                    .join(Other_loans, "Entity_ID", "full_outer")
                    .join(Investment_funds, "Entity_ID", "full_outer"))

illiquid_cols = [c for c in ["Bond_lending", "Instrument_Illiquid", "Other_loans", "Investment_funds", "Repo"]
                 if c in illiquid_tot.columns]
stack_expr = "stack({0}, {1}) as (category, Market_Value)".format(
    len(illiquid_cols), ", ".join(["'{0}', {0}".format(c) for c in illiquid_cols])
)
illiquid_trnsp = illiquid_tot.selectExpr("Entity_ID", stack_expr)

illiquid_assets = illiquid.unionByName(illiquid_trnsp)
illiquid_assets = illiquid_assets.withColumn(
    "category",
    F.when(F.col("category") == "Bond_lending",        F.lit("Bonds blocked by bond lending"))
     .when(F.col("category") == "Instrument_Illiquid", F.lit("Instrument with IFRS 7 level > 1"))
     .when(F.col("category") == "Other_loans",         F.lit("Other loans (incl Loans on policies)"))
     .when(F.col("category") == "Investment_funds",    F.lit("Investment funds (Closed or monthly valuation)"))
     .otherwise(F.col("category"))
)
illiquid_assets = illiquid_assets.withColumn(
    "Market_Value",
    F.when((F.col("category") == "Repo") & (F.col("Market_Value") < 0), F.lit(0))
     .otherwise(F.col("Market_Value"))
)
illiquid_assets = illiquid_assets.withColumn("reporting_date", F.lit(THISRUN_REPORTING_DATE).cast("date"))
illiquid_assets = illiquid_assets.withColumn("liquidity_category", F.lit("Illiquid"))


# -------------------------------------------------------------------------------------
# Create Liquid Assets Table
# -------------------------------------------------------------------------------------
Liquid = spark.sql("""
    select Entity_ID, Instrument_lmt, sum(Investment_SII_Value)/1000000 as Market_Value
    from AssetDBEntry_Conso_enriched
    where Instrument_lmt in ('Cash and cash equivalents Part')
    group by 1,2
""")

equities_liquid = spark.sql("""
    select Entity_ID, sum(SDT_Value) as SDT_Value
    from SDT_LISTED
    where liquidity_assessment in ('Liquid', 'Under_watch')
    group by 1
""")

Instrument_liquid = spark.sql("""
    select Entity_ID, sum(Investment_SII_Value)/1000000 as Instrument_liquid
    from AssetDBEntry_Conso_enriched
    where Instrument_lmt in ('Bonds Part')
    and Liquidity_Assessment = 'Liquid'
    group by 1
""")

Investment_funds_liquid = spark.sql("""
    select Entity_ID, sum(Investment_SII_Value)/1000000 as Investment_funds
    from AssetDBEntry_Conso_enriched
    where Instrument_lmt in ('Investment Funds Bonds Part', 'Investment Funds Shares Part')
    and Liquidity_Assessment = 'Liquid'
    group by 1
""")

Repos = spark.sql(f"""
    select Entity_ID, (sum(ASSET_MASTER_MARKETVAL_ACC_INC)/1000000)*-1 as Repos
    from Assets_Liabilities
    where Solvency_alt_act_descr in ('Debts owed to credit institutions')
    and Instrument_Type in ('Repos')
    and reporting_date = date('{THISRUN_REPORTING_DATE}')
    group by 1
""")

# data Repos; merge Reverse_repos Repos; (one to one merge) if Repo < 0 then Repos = sum(Repo, Repos);
Repos = Repos.withColumn("_row", F.row_number().over(Window.orderBy("Entity_ID")))
if nobs != 0:
    Repo_pos = (Reverse_repos
                .withColumn("_row", F.row_number().over(Window.orderBy("MAGNITUDE_ACCOUNT_5POS")))
                .select("_row", "Repo"))
    Repos = Repos.join(Repo_pos, "_row", "full_outer")
else:
    Repos = Repos.withColumn("Repo", F.lit(None).cast("double"))

Repos = Repos.withColumn(
    "Repos",
    F.when(F.col("Repo") < 0,
           F.coalesce(F.col("Repo"), F.lit(0)) + F.coalesce(F.col("Repos"), F.lit(0)))
     .otherwise(F.col("Repos"))
).select("_row", "Repos")

liquid_tot = (equities_liquid
              .join(Instrument_liquid, "Entity_ID", "full_outer")
              .join(Investment_funds_liquid, "Entity_ID", "full_outer")
              .join(bond_lending, "Entity_ID", "full_outer"))
# SAS merge without BY = one to one merge (by observation number)
liquid_tot = liquid_tot.withColumn("_row", F.row_number().over(Window.orderBy("Entity_ID")))
liquid_tot = liquid_tot.join(Repos, "_row", "left").drop("_row")

liquid_cols = [c for c in ["SDT_Value", "Instrument_liquid", "Investment_funds", "Repos", "Bond_lending"]
               if c in liquid_tot.columns]
stack_expr = "stack({0}, {1}) as (Instrument_lmt, Market_Value)".format(
    len(liquid_cols), ", ".join(["'{0}', {0}".format(c) for c in liquid_cols])
)
liquid_trnsp = liquid_tot.selectExpr("Entity_ID", stack_expr)

Liquid_assets = Liquid.unionByName(liquid_trnsp)
Liquid_assets = Liquid_assets.withColumn(
    "Market_Value",
    F.when(F.col("Instrument_lmt") == "Bond_lending", F.lit(-1) * F.col("Market_Value"))
     .otherwise(F.col("Market_Value"))
)
Liquid_assets = Liquid_assets.withColumn(
    "category",
    F.when(F.col("Instrument_lmt") == "Bond_lending",      F.lit("Bonds blocked by repo/bond lending"))
     .when(F.col("Instrument_lmt") == "SDT_Value",         F.lit("Equities - listed with SDT <= 7days"))
     .when(F.col("Instrument_lmt") == "Instrument_liquid", F.lit("Instrument with IFRS 7 level = 1"))
     .when(F.col("Instrument_lmt") == "Investment_funds",  F.lit("Investment funds (open and daily valuation)"))
     .otherwise(F.col("Instrument_lmt"))
).drop("Instrument_lmt")
Liquid_assets = Liquid_assets.withColumn("reporting_date", F.lit(THISRUN_REPORTING_DATE).cast("date"))
Liquid_assets = Liquid_assets.withColumn("liquidity_category", F.lit("Liquid"))

LIQUID_ILLIQUID_ASSETS = illiquid_assets.unionByName(Liquid_assets)
LIQUID_ILLIQUID_ASSETS.write.mode("overwrite").saveAsTable("OUT_LM.LIQUID_ILLIQUID_ASSETS")


