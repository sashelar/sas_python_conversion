# -------------------------------------------------------------------------------------
# 4. Table: Limits on Other bonds (excl. Government Bonds) depending on the Ultimate parent Rating
# -------------------------------------------------------------------------------------
Limits_Otherbonds_UltimateParent = spark.sql("""
    select reporting_date, Entity_ID, Ultimate_Parent_Risk, Issuer, Sector_Risk,
            Rating_Ultimate_Parent_Risk, LIMITS_ISSUER,
            sum(Accouting_Val_IFRS_Accrued_Incl) as book_value,
            sum(Quantity_Accounting) as Quantity
    from AssetDBEntry_Conso_enriched
    where fixed_income_indicator = 'Fixed Income'
    and Instrument_lmt not in ('Investment Funds Bonds Part', 'Investment Funds Shares Part')
    and Sector_Risk not in ('Sovereigns')
    and affectation not in ('BELINS HIGH YIELD', 'Belins NON LIFE LENDING', 'FIN_OTHER_B23')
    group by 1,2,3,4,5,6,7
    having Rating_Ultimate_Parent_Risk is not null
""")
Limits_Otherbonds_UltimateParent.createOrReplaceTempView("Limits_Otherbonds_UltimateParent")

other_bonds_limits = spark.sql("""
    select distinct Ultimate_Parent_Risk
    from other_bonds_limits
""")
other_bonds_limits.createOrReplaceTempView("other_bonds_limits")

Limits_Otherbonds_UltimateParent = spark.sql("""
    select a.*,
            case when b.Ultimate_Parent_Risk is not null then 'NO' end as Breach
    from Limits_Otherbonds_UltimateParent a
    left outer join other_bonds_limits b
    on a.Ultimate_Parent_Risk = b.Ultimate_Parent_Risk
""")

Limits_Otherbonds_UltimateParent = Limits_Otherbonds_UltimateParent.withColumn(
    "Breach",
    F.when((F.col("book_value") < F.col("LIMITS_ISSUER")) |
           (F.col("Breach").isNotNull()) |
           (F.col("LIMITS_ISSUER") == 0), F.lit("NO"))
     .otherwise(F.lit("YES"))
)
Limits_Otherbonds_UltimateParent.write.mode("overwrite").saveAsTable("OUT_LM.Limits_Otherbonds_UltimateParent")
