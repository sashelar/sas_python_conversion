# -------------------------------------------------------------------------------------
# SDT calculations
# NB: in SAS, sum(0, volume_avg_1M * 0.3) has 2 arguments -> it is the ROW level sum
#     function (not an aggregate), so it is kept as an attribute of the asset here.
# -------------------------------------------------------------------------------------
SDT = spark.sql("""
    select distinct Entity_ID, Instrument_Lmt, Assets_code_agr, Issuer,
            sum(Investment_SII_Value) as market_value,
            coalesce(max(volume_avg_1M) * 0.3, 0) as volume_avg_1M,
            sum(Quantity_Accounting) as quantity
    from AssetDBEntry_Conso_enriched
    where Instrument_Lmt in ('Equities-listed', 'Equities-unlisted', 'Investment Funds Shares Part')
    group by 1,2,3,4
""")
SDT.createOrReplaceTempView("SDT")

SDT_ALL = SDT.withColumn("price_per_action", F.col("market_value") / F.col("quantity"))

# select liquid quantity
SDT_ALL = SDT_ALL.withColumn(
    "liquid_quantity",
    F.when(F.col("volume_avg_1M") * 7 > F.col("quantity"), F.col("quantity"))
     .otherwise(F.col("volume_avg_1M") * 7)
)
# select under watch quantity
SDT_ALL = SDT_ALL.withColumn(
    "underwatch_quantity",
    F.when(F.col("liquid_quantity") == F.col("quantity"), F.lit(0))
     .when((F.col("quantity") - F.col("liquid_quantity")) < (F.col("volume_avg_1M") * 0),
           F.col("quantity") - F.col("liquid_quantity"))
     .otherwise(F.col("volume_avg_1M") * 0)
)
# select illiquid quantity
SDT_ALL = SDT_ALL.withColumn(
    "illiquid_quantity",
    F.col("quantity") - F.col("underwatch_quantity") - F.col("liquid_quantity")
)
# Market Value for the liquidity assessment quantity
SDT_ALL = SDT_ALL.withColumn("Liquid_MV",     F.col("price_per_action") * F.col("liquid_quantity"))
SDT_ALL = SDT_ALL.withColumn("Illiquid_MV",   F.col("price_per_action") * F.col("illiquid_quantity"))
SDT_ALL = SDT_ALL.withColumn("Underwatch_MV", F.col("price_per_action") * F.col("underwatch_quantity"))
SDT_ALL.createOrReplaceTempView("SDT_ALL")

SDT_ALL_FULL = spark.sql("""
    select Entity_ID,
            sum(Liquid_MV)/1000000 as Liquid,
            sum(Illiquid_MV)/1000000 as Illiquid,
            sum(Underwatch_MV)/1000000 as Under_watch
    from SDT_ALL
    group by Entity_ID
""")

SDT_ALL_LISTED = spark.sql("""
    select Entity_ID,
            sum(Liquid_MV)/1000000 as Liquid,
            sum(Illiquid_MV)/1000000 as Illiquid,
            sum(Underwatch_MV)/1000000 as Under_watch
    from SDT_ALL
    where Instrument_Lmt = 'Equities-listed'
    group by Entity_ID
""")

# proc transpose by Entity_ID -> one row per liquidity_assessment
SDT_ALL_FULL_TR = SDT_ALL_FULL.selectExpr(
    "Entity_ID",
    "stack(3, 'Liquid', Liquid, 'Illiquid', Illiquid, 'Under_watch', Under_watch) as (liquidity_assessment, SDT_Value)"
)
SDT_ALL_LISTED_TR = SDT_ALL_LISTED.selectExpr(
    "Entity_ID",
    "stack(3, 'Liquid', Liquid, 'Illiquid', Illiquid, 'Under_watch', Under_watch) as (liquidity_assessment, SDT_Value)"
)

SDT = SDT_ALL_FULL_TR.withColumn("reporting_date", F.lit(THISRUN_REPORTING_DATE).cast("date"))
SDT.write.mode("overwrite").saveAsTable("OUT_LM.SDT")

SDT_LISTED = SDT_ALL_LISTED_TR.withColumn("reporting_date", F.lit(THISRUN_REPORTING_DATE).cast("date"))
SDT_LISTED.createOrReplaceTempView("SDT_LISTED")
# End SDT calculation

# -------------------------------------------------------------------------------------
# Allocate the SDT market values back on the asset level
# -------------------------------------------------------------------------------------
AssetDBEntry_Conso_enriched = spark.sql("""
    select 	a.*,
            (a.Quantity_Accounting/b.quantity) * b.Liquid_MV as LIQUID_MV,
            (a.Quantity_Accounting/b.quantity) * b.Illiquid_MV as ILLIQUID_MV,
            (a.Quantity_Accounting/b.quantity) * b.Underwatch_MV as UNDERWATCH_MV
    from AssetDBEntry_Conso_enriched a
    left outer join SDT_ALL b
    on a.Entity_ID = b.Entity_ID
    and a.Assets_code_agr = b.Assets_code_agr
""")

instrument_lmt_liq_list = ["Bonds Part", "Investment Funds Bonds Part", "Investment Funds Shares Part",
                           "Loans & mortgages to individuals", "Loans on policies",
                           "Loans Part", "Strategic Participation Part"]

AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(
    "LIQUID_MV",
    F.when(F.col("Instrument_lmt").isin(instrument_lmt_liq_list),
           F.col("Investment_SII_Value") * F.coalesce((F.col("Liquidity_Assessment") == "Liquid").cast("int"), F.lit(0)))
     .when(F.col("Instrument_lmt") == "Cash and cash equivalents Part", F.col("Investment_SII_Value"))
     .otherwise(F.col("LIQUID_MV"))
)
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(
    "ILLIQUID_MV",
    F.when(F.col("Instrument_lmt").isin(instrument_lmt_liq_list),
           F.col("Investment_SII_Value") * F.coalesce((F.col("Liquidity_Assessment") == "Illiquid").cast("int"), F.lit(0)))
     .when(F.col("Instrument_lmt") == "Properties", F.col("Investment_SII_Value"))
     .otherwise(F.col("ILLIQUID_MV"))
)
AssetDBEntry_Conso_enriched.createOrReplaceTempView("AssetDBEntry_Conso_enriched")


