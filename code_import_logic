                data_source_file=src_file,
                file_delimiter=file_delimiter,
                file_date_format=src_date_fmt,
                file_datetime_format=src_datetime_fmt)
            print(datetime.now(), src_id, imported_src.count(), " lines")
            dicts[src_id]=imported_src
    return dicts





      
