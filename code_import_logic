        print(datetime.now(), src_id, src_file)
        # testing if file exists
        if not src_file or not utility_file_exists(src_file):
            print("File does not exist", src_id, src_file)

        # loading the files using functions
        elif src_import_method=="FUNCTION":
            if src_file:
                try:
                    # print("src file exists")
                    dicts[src_id]=globals()[src_fct](Source_File=src_file)
                    print(datetime.now()  , src_id, src_fct, src_file)
                except:
                    print(src_id, src_fct, "failed")
            else:
                try:
                    print("no src file", src_id, src_file)
                    dicts[src_id]=globals()[src_fct]()
                    print(datetime.now()  , src_id, src_fct)
                except:
                    print(src_id, src_fct, "failed", src_file)
                
        elif src_import_method=='EXCEL':
            try:
                imported_src=import_structured_xlsx(
                    layer=layer,
                    meta_source_folder=metadata_source_folder,
                    meta_source_file=metadata_source_file, 
                    meta_source_id=src_id, 
                    data_source_file=src_file, 
                    data_sheet_name=src_sheet_name)
                print(datetime.now(), src_id, imported_src.count(), " lines")
                dicts[src_id]=imported_src
            except:
                print(src_file, "failed")
        elif src_import_method in ['CSV', 'PIPE', "TAB"]:

            if src_import_method=="PIPE":
                file_delimiter="|"
