data_bonds_exposure = spark.sql("""
select	Entity_ID,
			ALM_segment,
			Assets_agr,
			Isin_agr,
			sum(Quantity_Accounting) as quantity_accounting,
			sum(Accouting_Val_IFRS_Accrued_Incl) as ACCOUTING_VAL_IFRS_ACCRUED_INCL,
