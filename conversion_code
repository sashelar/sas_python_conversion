    when 	(Solvency_alt_act_descr	="Government Bonds") 																																							Instrument_lmt ='Bonds Part';
	when 	(Solvency_alt_act_descr	="Collateralised securities") 																																					Instrument_lmt ='Bonds Part';
	when 	(Solvency_alt_act_descr	="Structured notes") 																																							Instrument_lmt ='Bonds Part';
    when 	(Solvency_alt_act_descr	="Other loans & mortgages") 																																					Instrument_lmt ='Loans Part';
	when 	(Solvency_alt_act_descr	="Investment funds" and (Investment_Category_Solvency = "Debt Funds" or Investment_Category_Solvency = "Money Market Funds" )) 													Instrument_lmt ='Investment Funds Bonds Part';
	when 	(Investment_Category_Solvency = "Participations" and substr(CIC,1,2) not in ("XL", "XT") and Participation_Solvency in ("2YNGNS", "2YGNS") and BSM_split not in ("Buildings", "Fonds Obligataires"))	Instrument_lmt ='Equities-listed';
	when 	(Investment_Category_Solvency = "Participations" and substr(CIC,1,2) not in ("XL", "XT") and Participation_Solvency in ("2YNGNS", "2YGNS") and BSM_split = "Buildings")									Instrument_lmt ='Properties';
	when 	(Investment_Category_Solvency = "Participations" and substr(CIC,1,2) not in ("XL", "XT") and Participation_Solvency in ("2YNGNS", "2YGNS") and BSM_split = "Fonds Obligataires")						Instrument_lmt ='Investment Funds Bonds Part';
	when 	(Solvency_alt_act_descr	="Equities - listed" and BSM_split not in ("Buildings","Fonds Obligataires")) 																									Instrument_lmt ='Equities-listed';
	when 	(Solvency_alt_act_descr	="Equities - listed" and BSM_split = "Buildings") 																																Instrument_lmt ='Properties';
	when 	(Solvency_alt_act_descr	="Equities - listed" and BSM_split = "Fonds Obligataires") 																														Instrument_lmt ='Investment Funds Bonds Part';
    when 	(Investment_Category_Solvency = "Participations" and substr(CIC,1,2) in ("XL", "XT") and Participation_Solvency in ("2YNGNS", "2YGNS") and BSM_split not in ("Buildings","Fonds Obligataires"))			Instrument_lmt ='Equities-unlisted';
	when 	(Investment_Category_Solvency = "Participations" and substr(CIC,1,2) in ("XL", "XT") and Participation_Solvency in ("2YNGNS", "2YGNS") and BSM_split = "Buildings")										Instrument_lmt ='Properties';
	when 	(Investment_Category_Solvency = "Participations" and substr(CIC,1,2) in ("XL", "XT") and Participation_Solvency in ("2YNGNS", "2YGNS") and BSM_split = "Fonds Obligataires")							Instrument_lmt ='Investment Funds Bonds Part';
	when 	(Solvency_alt_act_descr	="Equities - unlisted" and BSM_split not in ("Buildings","Fonds Obligataires")) 																								Instrument_lmt ='Equities-unlisted';
	when 	(Solvency_alt_act_descr	="Equities - unlisted" and BSM_split = "Buildings") 																															Instrument_lmt ='Properties';
	when 	(Solvency_alt_act_descr	="Equities - unlisted" and BSM_split = "Fonds Obligataires") 																													Instrument_lmt ='Investment Funds Bonds Part';
	when 	(Solvency_alt_act_descr	="Investment funds" and Investment_Category_Solvency in("Equities","Shares","Buffer T23") and BSM_split ne "Buildings") 														Instrument_lmt ='Investment Funds Shares Part';
	when 	(Solvency_alt_act_descr	="Investment funds" and Investment_Category_Solvency in("Equities","Shares","Buffer T23") and BSM_split = "Buildings") 															Instrument_lmt ='Properties';
	when 	(Investment_Category_Solvency = "Participations" and substr(CIC,1,2) in ("XL", "XT") and (Participation_Solvency = "2YGS" or Participation_Solvency = "2YNGS")) 										Instrument_lmt ='Strategic Participation Part';
	when 	(Solvency_alt_act_descr	="Cash and cash equivalents") 																																					Instrument_lmt ='Cash and cash equivalents Part';
	when    (Solvency_alt_act_descr	="Property (other than for own use)" or Solvency_alt_act_descr	="Property, plant & equipement held for own use") 																Instrument_lmt ='Properties';
	when    (Solvency_alt_act_descr	="Loans & mortgages to individuals" and (Investment_Category_Solvency = "Mortgages" or Investment_Category_Solvency = "Other Loans")) 											Instrument_lmt ='Loans & mortgages to individuals';
