proc sql noprint;
	create table work.AssetDBEntry_Conso_enriched as
	select	a.*,
			b.DEFAULT_PROB as DEFAULT_PROB_LOW,
			c.DEFAULT_PROB as DEFAULT_PROB_UP
	from work.AssetDBEntry_Conso_enriched a
	left outer join work.DEFAULT_PROBABILITY b
	on a.RATING_WATERFALL = b.RATING
	and a.REM_MAT_LOW = b.MATURITY
	left outer join work.DEFAULT_PROBABILITY c
	on a.RATING_WATERFALL = c.RATING
	and a.REM_MAT_UP = c.MATURITY;
quit;

data work.AssetDBEntry_Conso_enriched;
set work.AssetDBEntry_Conso_enriched;
if REM_MAT_LOW = REM_MAT_UP then DEFAULT_PROB = DEFAULT_PROB_LOW;
else DEFAULT_PROB = (REM_MAT_UP - REM_MAT) * DEFAULT_PROB_LOW + (REM_MAT - REM_MAT_LOW) * DEFAULT_PROB_UP; 
RATING_FACTOR_INTERNAL_DUR = DEFAULT_PROB * 10000;
if SOLVENCY_ALT_ACT_NEW = "R0250" then
	do;
		RATING_FACTOR_INTERNAL_DUR = rating_factor_internal_mortgages;
	end;
REMAINING_MATURITY_TIMES_IFRS_BV = REM_MAT * ACCOUTING_VAL_IFRS_ACCRUED_INCL;
RATING_FAC_INT_DUR_TIMES_IFRS_BV = RATING_FACTOR_INTERNAL_DUR * ACCOUTING_VAL_IFRS_ACCRUED_INCL;
drop DEFAULT_PROB_LOW DEFAULT_PROB_UP DEFAULT_PROB REM_MAT_LOW REM_MAT_UP rating_factor_internal_mortgages Rem_Mat_Mortgages;
rename REM_MAT = REMAINING_MATURITY;
run;

/*Update of WARF computation to take into account spreadlocks transactions*/
proc sql noprint;
	create table work.data_spreadlocks as
	select	entity_id,
			alm_segment,
			asset_master,
			asset_master_isin,
			sum(quantity_accounting) as quantity_accounting
	from work.AssetDBEntry_Conso_enriched
	where solvency_alt_act_new = "R0190" and BSM_split = "Forward Bonds"
	group by 1,2,3,4;

	create table work.data_bonds_exposure as
	select	entity_id,
			alm_segment,
			assets_agr,
			isin_agr,
			sum(quantity_accounting) as quantity_accounting,
			sum(ACCOUTING_VAL_IFRS_ACCRUED_INCL) as ACCOUTING_VAL_IFRS_ACCRUED_INCL,
			sum(RATING_FAC_INT_DUR_TIMES_IFRS_BV) as RATING_FAC_INT_DUR_TIMES_IFRS_BV
	from work.AssetDBEntry_Conso_enriched
	where solvency_alt_act_new in ("R0140","R0150","R0160","R170")
	group by 1,2,3,4;

	create table work.compute_spreadlocks as
	select	t1.*,
			t2.quantity_accounting as quantity_exposure,
			t2.ACCOUTING_VAL_IFRS_ACCRUED_INCL,
			t2.RATING_FAC_INT_DUR_TIMES_IFRS_BV
	from work.data_spreadlocks t1
	left outer join work.data_bonds_exposure t2
	on t1.entity_id = t2.entity_id
	and t1.alm_segment = t2.alm_segment
	and t1.asset_master = t2.assets_agr
	and t1.asset_master_isin = t2.isin_agr;
quit;

data work.compute_spreadlocks_2;
set work.compute_spreadlocks;
spreadlock_coverage = sum(0,quantity_accounting / quantity_exposure);
run;

proc sql noprint;
	create table work.AssetDBEntry_Conso_enriched as
	select 	t1.*,
			t2.spreadlock_coverage
	from work.AssetDBEntry_Conso_enriched t1
	left outer join work.compute_spreadlocks_2 t2
	on t1.entity_id = t2.entity_id
	and t1.alm_segment = t2.alm_segment
	and t1.assets_agr = t2.asset_master
	and t1.isin_agr = t2.asset_master_isin;
quit;

data work.AssetDBEntry_Conso_enriched;
set work.AssetDBEntry_Conso_enriched ;
RAT_INT_DUR_TIMES_IFRS_BV_NOSL = RATING_FAC_INT_DUR_TIMES_IFRS_BV;
if not missing(spreadlock_coverage) then
	RATING_FAC_INT_DUR_TIMES_IFRS_BV = (1-spreadlock_coverage) * RATING_FAC_INT_DUR_TIMES_IFRS_BV;
drop spreadlock_coverage;
run;

/*SDT calculations*/
proc sql;
create table SDT as
select distinct entity_id, Instrument_Lmt, ASSETS_CODE_AGR, Issuer, sum(investment_SII_value) as market_value, 
		sum(0,volume_avg_1M * 0.3) as volume_avg_1M, sum(quantity_accounting) as quantity
from AssetDBEntry_Conso_enriched
where Instrument_Lmt in ('Equities-listed', 'Equities-unlisted','Investment Funds Shares Part')
group by 1,2,3,4;
run;

data SDT_ALL;
set SDT;
price_per_action = market_value/quantity;
/*select liquid quantity*/
	if volume_avg_1m*7 > quantity then liquid_quantity= quantity; 
	else liquid_quantity = volume_avg_1m*7;
/*select under watch quantity*/
		if liquid_quantity = quantity then underwatch_quantity = 0;
		else if (quantity - liquid_quantity) < (volume_avg_1M*0) then underwatch_quantity = quantity - liquid_quantity;
		else underwatch_quantity = volume_avg_1M*0;
/*select illiquid quantity*/
			illiquid_quantity = quantity - underwatch_quantity - liquid_quantity;
/*Market Value for the liquidity assessment quantity*/
				Liquid_MV=price_per_action*liquid_quantity;
				Illiquid_MV=price_per_action*illiquid_quantity;
				Underwatch_MV=price_per_action*underwatch_quantity;
run;

proc sql;
create table SDT_ALL_FULL as
select entity_ID, sum(Liquid_MV)/1000000 as Liquid, sum(Illiquid_MV)/1000000 as Illiquid, sum(Underwatch_MV)/1000000 as Under_watch
from SDT_ALL
group by entity_ID;
quit;

proc sql;
create table SDT_ALL_LISTED as
select entity_ID, sum(Liquid_MV)/1000000 as Liquid, sum(Illiquid_MV)/1000000 as Illiquid, sum(Underwatch_MV)/1000000 as Under_watch
from SDT_ALL
