having not(missing(Ultimate_parent_risk));
quit;

proc sql;
create table ultimate_parent_limits as
select distinct ultimate_parent_risk
from ultimate_parent_limits;
run;


proc sql;
create table Limits_Issuer_UltimateParent as
select a.*, 
	case when exists 
			(select ultimate_parent_risk from ultimate_parent_limits where a.ultimate_parent_risk = b.ultimate_parent_risk)
				then 'NO' end as Breach
from Limits_Issuer_UltimateParent a
left outer join ultimate_parent_limits b
on a.ultimate_parent_risk = b.ultimate_parent_risk
;
quit;

data Limits_Issuer_UltimateParent;
length Breach $6.;
set Limits_Issuer_UltimateParent;
if Book_value lt 150000000 or not(missing(Breach)) then Breach = "NO";
else Breach = "YES";
