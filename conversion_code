AssetDBEntry_Conso_enriched = spark.table("AssetDBEntry_Conso_enriched")

from pyspark.sql import functions as F  
from pyspark.sql.functions import col, when ,coalesce 
  
# Définition de l'expression pour la colonne Instrument_lmt  
instrument_lmt_expr = """  
    CASE  
        WHEN Solvency_alt_act_descr = 'Corporate Bonds' THEN 'Bonds Part'  
        WHEN Solvency_alt_act_descr = 'Government Bonds' THEN 'Bonds Part'  
        WHEN Solvency_alt_act_descr = 'Collateralised securities' THEN 'Bonds Part'  
        WHEN Solvency_alt_act_descr = 'Structured notes' THEN 'Bonds Part'  
        WHEN Solvency_alt_act_descr = 'Other loans & mortgages' THEN 'Loans Part'  
        WHEN Solvency_alt_act_descr = 'Investment funds' AND Investment_Category_Solvency IN ('Debt Funds', 'Money Market Funds') THEN 'Investment Funds Bonds Part'  
        WHEN Investment_Category_Solvency = 'Participations' AND substring(CIC, 1, 2) NOT IN ('XL', 'XT') AND  
             Participation_Solvency IN ('2YNGNS', '2YGNS') AND BSM_split NOT IN ('Buildings', 'Fonds Obligataires') THEN 'Equities-listed'  
        WHEN Investment_Category_Solvency = 'Participations' AND substring(CIC, 1, 2) NOT IN ('XL', 'XT') AND  
             Participation_Solvency IN ('2YNGNS', '2YGNS') AND BSM_split = 'Buildings' THEN 'Properties'  
        WHEN Investment_Category_Solvency = 'Participations' AND substring(CIC, 1, 2) NOT IN ('XL', 'XT') AND  
             Participation_Solvency IN ('2YNGNS', '2YGNS') AND BSM_split = 'Fonds Obligataires' THEN 'Investment Funds Bonds Part'  
        WHEN Solvency_alt_act_descr = 'Equities - listed' AND BSM_split NOT IN ('Buildings', 'Fonds Obligataires') THEN 'Equities-listed'  
        WHEN Solvency_alt_act_descr = 'Equities - listed' AND BSM_split = 'Buildings' THEN 'Properties'  
        WHEN Solvency_alt_act_descr = 'Equities - listed' AND BSM_split = 'Fonds Obligataires' THEN 'Investment Funds Bonds Part'  
        WHEN Investment_Category_Solvency = 'Participations' AND substring(CIC, 1, 2) IN ('XL', 'XT') AND  
             Participation_Solvency IN ('2YNGNS', '2YGNS') AND BSM_split NOT IN ('Buildings', 'Fonds Obligataires') THEN 'Equities-unlisted'  
        WHEN Investment_Category_Solvency = 'Participations' AND substring(CIC, 1, 2) IN ('XL', 'XT') AND  
             Participation_Solvency IN ('2YNGNS', '2YGNS') AND BSM_split = 'Buildings' THEN 'Properties'  
        WHEN Investment_Category_Solvency = 'Participations' AND substring(CIC, 1, 2) IN ('XL', 'XT') AND  
             Participation_Solvency IN ('2YNGNS', '2YGNS') AND BSM_split = 'Fonds Obligataires' THEN 'Investment Funds Bonds Part'  
        WHEN Solvency_alt_act_descr = 'Equities - unlisted' AND BSM_split NOT IN ('Buildings', 'Fonds Obligataires') THEN 'Equities-unlisted'  
        WHEN Solvency_alt_act_descr = 'Equities - unlisted' AND BSM_split = 'Buildings' THEN 'Properties'  
        WHEN Solvency_alt_act_descr = 'Equities - unlisted' AND BSM_split = 'Fonds Obligataires' THEN 'Investment Funds Bonds Part'  
        WHEN Solvency_alt_act_descr = 'Investment funds' AND Investment_Category_Solvency IN ('Equities', 'Shares', 'Buffer T23') AND BSM_split != 'Buildings' THEN 'Investment Funds Shares Part'  
        WHEN Solvency_alt_act_descr = 'Investment funds' AND Investment_Category_Solvency IN ('Equities', 'Shares', 'Buffer T23') AND BSM_split = 'Buildings' THEN 'Properties'  
        WHEN Investment_Category_Solvency = 'Participations' AND substring(CIC, 1, 2) IN ('XL', 'XT') AND  
             Participation_Solvency IN ('2YGS', '2YNGS') THEN 'Strategic Participation Part'  
        WHEN Solvency_alt_act_descr = 'Cash and cash equivalents' THEN 'Cash and cash equivalents Part'  
        WHEN Solvency_alt_act_descr IN ('Property (other than for own use)', 'Property, plant & equipement held for own use') THEN 'Properties'  
        WHEN Solvency_alt_act_descr = 'Loans & mortgages to individuals' AND Investment_Category_Solvency IN ('Mortgages', 'Other Loans') THEN 'Loans & mortgages to individuals'  
        WHEN Solvency_alt_act_descr = 'Loans on policies' THEN 'Loans on policies'  
        WHEN assets_code_agr = 'Alan SA' THEN 'Equities-unlisted (excluded)'  
        ELSE ''  
    END  
"""  
  
# Application de la transformation  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(  
    "Instrument_lmt",  
    F.expr(instrument_lmt_expr)  
)


AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(  
    "Beta_Equities",  
    F.when(  
        F.col("instrument_lmt") == "Equities-listed",  
        F.col("BETA") * F.col("Investment_SII_Value")  
    ).otherwise(  
        F.col("Beta_Equities") if "Beta_Equities" in AssetDBEntry_Conso_enriched.columns  
        else F.lit(None)  
    )  
)  


AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(
    "Rating_Factor_Internal",
    F.when(
        F.col("solvency_alt_act_descr") != "Investment funds" ,
        F.col("Rating_Factor")
    ).otherwise(
        F.col("Rating_Factor_Internal") if "Rating_Factor_Internal" in AssetDBEntry_Conso_enriched.columns
        else F.lit(None))
)


# Assuming AssetDBEntry_Conso_enriched is already a Spark DataFrame  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(  
    "RATING_SOLVENCY_INTERNAL",  
    F.when(  
        (F.col("solvency_alt_act_descr") == "Investment funds") &  
        (F.col("rating_factor_internal").isNotNull()),  
        F.col("Rating_Waterfall_Funds")  
    ).otherwise(
        F.col("RATING_SOLVENCY_INTERNAL") if "RATING_SOLVENCY_INTERNAL" in AssetDBEntry_Conso_enriched.columns
        else F.lit(None))  
)  
  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(  
    "rating_waterfall",  
    F.when(  
        (F.col("solvency_alt_act_descr") == "Investment funds") &  
        (F.col("rating_factor_internal").isNotNull()),  
        coalesce(F.col("RATING_SOLVENCY_INTERNAL"), F.col("RATING_SOLVENCY_EXTERNAL"), F.lit("NR"))  
    ).otherwise(
        F.col("rating_waterfall") if "rating_waterfall" in AssetDBEntry_Conso_enriched.columns
        else F.lit(None))  
)  
  
# Drop columns  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.drop("Internal_Rating_Factor", "Rating_Waterfall_Funds")  


from pyspark.sql.functions import when, floor, ceil, datediff, lit, greatest, least  
  
# 1. Create REM_MAT with exact SAS conditions  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(
    "REM_MAT",  
    when(F.col("Rem_Mat_Funds").isNotNull(), F.col("Rem_Mat_Funds"))  
    .when(F.col("Rem_Mat_Mortgages").isNotNull(), F.col("Rem_Mat_Mortgages"))  
    .when(F.col("Asset_Redemption_Date_Agr").isNotNull(),  
         datediff(F.col("ASSET_REDEMPTION_DATE_AGR"), F.col("reporting_date"))/360)  
)  
  
# 2. Calculate REM_MAT_LOW with exact SAS conditions  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(
    "REM_MAT_LOW",  
    when(F.col("Rem_Mat_Funds").isNotNull(),  
        least(lit(0), greatest(lit(0), floor(F.col("REM_MAT")))))  
    .when(F.col("Rem_Mat_Mortgages").isNotNull(),  
        least(lit(0), greatest(lit(0), floor(F.col("REM_MAT")))))  
    .when(F.col("Asset_Redemption_Date_Agr").isNotNull(),  
        least(lit(0), greatest(lit(0), floor(F.col("REM_MAT")))))  
)
  
# 3. Calculate REM_MAT_UP with exact SAS conditions  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn("REM_MAT_UP",  
    when(F.col("Rem_Mat_Funds").isNotNull(),  
        greatest(F.col("REM_MAT_LOW"), least(lit(50), ceil(F.col("REM_MAT")))))  
    .when(F.col("Rem_Mat_Mortgages").isNotNull(),  
        greatest(F.col("REM_MAT_LOW"), least(lit(50), ceil(F.col("REM_MAT")))))
    .when(F.col("Asset_Redemption_Date_Agr").isNotNull(),  
        greatest(F.col("REM_MAT_LOW"), least(lit(50), ceil(F.col("REM_MAT")))))  
)
  
# 4. Drop original columns  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.drop("Rem_Mat_Funds", "Rem_Mat_Mortgages")  


AssetDBEntry_Conso_enriched.createOrReplaceTempView("AssetDBEntry_Conso_enriched")
AssetDBEntry_Conso_enriched = spark.sql("""
	select	a.*,
			b.DEFAULT_PROB as DEFAULT_PROB_LOW,
			c.DEFAULT_PROB as DEFAULT_PROB_UP
	from AssetDBEntry_Conso_enriched a
	left outer join DEFAULT_PROBABILITY b
	on a.RATING_WATERFALL = b.RATING
	and a.REM_MAT_LOW = b.MATURITY
	left outer join DEFAULT_PROBABILITY c
	on a.RATING_WATERFALL = c.RATING
	and a.REM_MAT_UP = c.MATURITY;
""")


AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(
    "DEFAULT_PROB",  
    when(F.col("REM_MAT_LOW") == F.col("REM_MAT_UP"), F.col("DEFAULT_PROB_LOW"))  
    .otherwise(
        (((F.col("REM_MAT_UP") - F.col("REM_MAT")) * F.col("DEFAULT_PROB_LOW")) +  ((F.col("REM_MAT") - F.col("REM_MAT_LOW")) * F.col("DEFAULT_PROB_UP"))
          if "DEFAULT_PROB" in AssetDBEntry_Conso_enriched.columns
          else F.lit(None)
    )))

AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn("RATING_FACTOR_INTERNAL_DUR", F.col("DEFAULT_PROB") * 10000) 


AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn(  
"RATING_FACTOR_INTERNAL_DUR",  
when(F.col("Solvency_alt_act_new") == "R0250", F.col("rating_factor_internal_mortgages"))  
.otherwise(F.col("DEFAULT_PROB") * 10000)  
)

AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn("REMAINING_MATURITY_TIMES_IFRS_BV", F.col("REM_MAT") * F.col("Accouting_Val_IFRS_Accrued_Incl"))  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumn("RATING_FAC_INT_DUR_TIMES_IFRS_BV", F.col("RATING_FACTOR_INTERNAL_DUR") * F.col("Accouting_Val_IFRS_Accrued_Incl"))


  
# Drop and rename columns  
columns_to_drop = [  
    "DEFAULT_PROB_LOW", "DEFAULT_PROB_UP", "DEFAULT_PROB",  
    "REM_MAT_LOW", "REM_MAT_UP", "rating_factor_internal_mortgages",  
    "Rem_Mat_Mortgages"  
]  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.drop(*columns_to_drop)  
AssetDBEntry_Conso_enriched = AssetDBEntry_Conso_enriched.withColumnRenamed("REM_MAT", "REMAINING_MATURITY")
AssetDBEntry_Conso_enriched.createOrReplaceTempView("AssetDBEntry_Conso_enriched")


