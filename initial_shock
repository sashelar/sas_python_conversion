"""
apply_initial_shocks.py
 
PySpark version of the initial shocks engine for Azure Synapse.
 
The shock rules are in Initial_Shocks_<date>.xlsx, sheets "Shock_Assets" and
"Shock_Assets_Liabilities". RULE_DATA_SELECTION, RULE_TO_APPLY and
SHOCK_VARIABLE_CHAR are already written in Spark SQL, so this code only reads
the rules and applies them - no SAS translation anywhere.
 
Columns used:
    RULE_GROUP           the batch of shock rules to run
    RULE_ID              identifier of the rule
    RULE_DATA_SELECTION  Spark SQL condition - which rows the shock applies to
    RULE_TYPE            IF_THEN (shock RULE_VARIABLE) or DELETE (drop matching rows)
    SHOCK_TYPE           REPLACE_CHAR, REPLACE_NUM, ADD, MULT or NONE
    RULE_TO_APPLY        Spark SQL expression, used when SHOCK_TYPE is NONE
    RULE_VARIABLE        the column the shock writes
    SHOCK_VARIABLE_CHAR  text value for REPLACE_CHAR, in single quotes
    SHOCK_VARIABLE_NUM   number for REPLACE_NUM, ADD and MULT
    ACTIVE               Y, or N to skip the rule
 
The rules of a group are applied top to bottom, so the last matching rule wins.
"""
 
from pyspark.sql import functions as F
 
 
def shocked_value(rule):
    """Build the Spark SQL expression for the new value of RULE_VARIABLE."""
 
    shock_type = str(rule["SHOCK_TYPE"]).strip().upper()
    column = str(rule["RULE_VARIABLE"]).strip()
    shock_num = str(rule["SHOCK_VARIABLE_NUM"]).strip()
 
    if shock_type in ("", "NONE", "NAN"):
        return str(rule["RULE_TO_APPLY"]).strip()
 
    if shock_type == "REPLACE_CHAR":
        return str(rule["SHOCK_VARIABLE_CHAR"]).strip()
 
    if shock_type == "REPLACE_NUM":
        return shock_num
 
    if shock_type == "ADD":
        return "%s + %s" % (column, shock_num)
 
    if shock_type == "MULT":
        return "(1 + %s) * %s" % (shock_num, column)
 
    raise ValueError(
        "Unknown SHOCK_TYPE '%s' for RULE_ID '%s'. Expected REPLACE_CHAR, "
        "REPLACE_NUM, ADD, MULT or NONE." % (rule["SHOCK_TYPE"], rule["RULE_ID"])
    )
 
 
def apply_initial_shocks(in_impacted_df,
                         in_rule_df,
                         in_rule_group,
                         out_table_name=None):
    """Apply all shock rules of one rule group to a DataFrame."""
 
    rules = in_rule_df.filter(
        F.upper(F.trim(F.col("RULE_GROUP"))) == in_rule_group.strip().upper()
    ).collect()
 
    if not rules:
        raise ValueError("No shock rules found for rule group '%s'" % in_rule_group)
 
    df = in_impacted_df
 
    for rule in rules:
        if str(rule["ACTIVE"]).strip().upper() == "N":
            continue
 
        condition = str(rule["RULE_DATA_SELECTION"]).strip()
 
        if str(rule["RULE_TYPE"]).strip().upper() == "DELETE":
            df = df.filter("not (%s)" % condition)
            continue
 
        column = str(rule["RULE_VARIABLE"]).strip()
        new_value = shocked_value(rule)
 
        if column in df.columns:
            # the column already exists - keep its type, only change the value
            df = df.withColumn(
                column,
                F.when(F.expr(condition), F.expr(new_value)).otherwise(F.col(column))
            )
        else:
            if str(rule["SHOCK_TYPE"]).strip().upper() == "REPLACE_CHAR":
                column_type = "string"
            else:
                column_type = "double"
 
            df = df.withColumn(
                column,
                F.when(F.expr(condition), F.expr(new_value))
                 .otherwise(F.lit(None)).cast(column_type)
            )
 
    if out_table_name:
        df.write.mode("overwrite").saveAsTable(out_table_name)
 
    return df
 
 
# ---------------------------------------------------------------------------
# Example usage in a Synapse notebook
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    from pyspark.sql import SparkSession
 
    spark = SparkSession.builder.getOrCreate()
 
    # Shock_Assets for the assets only mode, Shock_Assets_Liabilities for A&L
    Shock_Assets = spark.table("dbo.Shock_Assets")
    AssetDBEntry_Conso_enriched = spark.table("dbo.AssetDBEntry_Conso_enriched")
 
    shock_groups = [
        "Rule_If_Then",
    ]
 
    for group in shock_groups:
        AssetDBEntry_Conso_enriched = apply_initial_shocks(
            in_impacted_df=AssetDBEntry_Conso_enriched,
            in_rule_df=Shock_Assets,
            in_rule_group=group,
        )
 
    AssetDBEntry_Conso_enriched.createOrReplaceTempView("AssetDBEntry_Conso_enriched")
 
