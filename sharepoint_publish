# =============================================================================
# SharePoint publisher helper
#   Flow:  ref / stg container  ->  sharepoint container  ->  SharePoint site
#   Usage: publish_to_sharepoint(mode="csv" | "txt" | "dataframe", ...)
# =============================================================================
from datetime import datetime
from typing import Optional, Union
from zoneinfo import ZoneInfo

from belfiusframework.connectors import CsvConnector as csv
from belfiusframework.connectors import SharepointConnector as sp
from belfiusframework.connectors import TxtConnector as txt

# ---------------------------------------------------------------------------
# Defaults – change once here instead of in every call
# ---------------------------------------------------------------------------
DEFAULT_SITE_PATH = "/sites/app-app-data-risk-belins-download"
DEFAULT_STAGING_FOLDER = "publish_to_sharepoint"  # folder inside the "sharepoint" layer
TIMEZONE = ZoneInfo("Europe/Brussels")

SUPPORTED_MODES = ("csv", "txt", "dataframe")
SUPPORTED_LAYERS = ("ref", "stg")
SUPPORTED_CONFIDENTIALITY = ("Public", "Internal", "Confidential", "Strictly Confidential")


def format_date_nicely(dt: Optional[datetime] = None) -> str:
    """Return e.g. 'Monday 9th of November 2026'."""
    if dt is None:
        dt = datetime.now(TIMEZONE)
    elif not isinstance(dt, datetime):
        raise ValueError("Input must be a datetime object or None")

    day = dt.day
    suffix = "th" if 11 <= day <= 13 else {1: "st", 2: "nd", 3: "rd"}.get(day % 10, "th")
    return f"{dt.strftime('%A')} {day}{suffix} of {dt.strftime('%B')} {dt.year}"


# ---------------------------------------------------------------------------
# Internal helpers (one per mode)
# ---------------------------------------------------------------------------
def _read_source(mode, source_layer, source_folder, source_file, extension, csv_options):
    """Read the file from ref/stg using the right connector."""
    if mode == "csv":
        read_kwargs = dict(
            delimiter=",",
            header=True,
            encoding="UTF-8",
            optimize=False,
            persist=False,
            inferschema=False,
            multiline=True,
            quote='"',
            escape='"',
        )
        read_kwargs.update(csv_options or {})
        # read_csv expects the file name WITH extension (e.g. "test_csv.csv")
        file_name = source_file if source_file.lower().endswith(".csv") else f"{source_file}.csv"
        return csv.read_csv(
            layer=source_layer,
            folder_name=source_folder,
            file_name=file_name,
            **read_kwargs,
        )

    if mode == "txt":
        # read_txt expects the file name WITHOUT extension + a separate extension
        return txt.read_txt(
            layer=source_layer,
            folder_name=source_folder,
            file_name=source_file,
            extension=extension,
        )

    raise ValueError(f"Cannot read source for mode '{mode}'")


def _write_to_sharepoint_layer(mode, data, staging_folder, staging_name, extension, csv_options, txt_options):
    """Write the data to the 'sharepoint' layer as a single file."""
    if mode in ("csv", "dataframe"):
        write_kwargs = dict(
            delimiter=",",
            header=True,
            encoding="UTF-8",
            remove_new_line_characters=True,
        )
        # only keep options that write_csv understands
        for key in ("delimiter", "header", "encoding", "remove_new_line_characters"):
            if csv_options and key in csv_options:
                write_kwargs[key] = csv_options[key]
        csv.write_csv(
            layer="sharepoint",
            data=data,
            folder_name=staging_folder,
            file_name=staging_name,
            single_file=True,
            **write_kwargs,
        )
        return

    if mode == "txt":
        write_kwargs = dict(delimiter=",", nr_of_output_files=1)
        write_kwargs.update(txt_options or {})
        txt.write_txt(
            layer="sharepoint",
            folder_name=staging_folder,
            file_name=staging_name,
            data=data,
            single_file=True,
            extension=extension,
            **write_kwargs,
        )
        return

    raise ValueError(f"Cannot write for mode '{mode}'")


# ---------------------------------------------------------------------------
# Public function
# ---------------------------------------------------------------------------
def publish_to_sharepoint(
    mode: str,
    target_folder: str,
    *,
    # --- source (ignored when mode="dataframe") ---
    source_layer: str = "ref",
    source_folder: Optional[str] = None,
    source_file: Optional[str] = None,
    extension: Optional[str] = None,
    # --- in-memory data (mode="dataframe") ---
    data=None,
    # --- target on SharePoint ---
    target_file_name: Optional[str] = None,
    dated_folder: bool = True,
    date_folder_format: str = "%Y-%m-%d",
    add_timestamp: bool = False,
    timestamp_format: str = "%Y%m%d_%H%M",
    confidentiality: str = "Public",
    pii_flag: bool = False,
    description: Optional[str] = None,
    sharepoint_site_path: str = DEFAULT_SITE_PATH,
    # --- staging ---
    staging_folder: str = DEFAULT_STAGING_FOLDER,
    staging_name: Optional[str] = None,
    # --- advanced connector options ---
    csv_options: Optional[dict] = None,
    txt_options: Optional[dict] = None,
    show_preview: bool = False,
) -> dict:
    """
    Read a file from ref/stg (or take a DataFrame), stage it in the 'sharepoint'
    layer and publish it to the SharePoint site.

    By default the file keeps a clean name and lands in a dated folder:
        <target_folder>/<YYYY-MM-DD>/<file>.<ext>
    Use dated_folder=False to skip the date folder, and add_timestamp=True to
    also put the time in the file name (useful for several runs per day).

    Modes:
        "csv"       -> read with CsvConnector, write with CsvConnector
        "txt"       -> read/write with TxtConnector; works for any text extension
                       (txt, fac, dat, ...) via `extension`
        "dataframe" -> you pass `data=` (Spark DataFrame), written as CSV

    Returns a dict with what was published (handy for logging).
    """
    # ------------------------- validation -------------------------
    mode = mode.lower().strip()
    if mode not in SUPPORTED_MODES:
        raise ValueError(f"mode must be one of {SUPPORTED_MODES}, got '{mode}'")
    if confidentiality not in SUPPORTED_CONFIDENTIALITY:
        raise ValueError(f"confidentiality must be one of {SUPPORTED_CONFIDENTIALITY}")

    if mode == "dataframe":
        if data is None:
            raise ValueError("mode='dataframe' requires data=<your DataFrame>")
        extension = "csv"
    else:
        if source_layer not in SUPPORTED_LAYERS:
            raise ValueError(f"source_layer must be one of {SUPPORTED_LAYERS}")
        if not source_folder or not source_file:
            raise ValueError("source_folder and source_file are required for csv/txt modes")
        if mode == "csv":
            extension = "csv"
        elif not extension:
            raise ValueError("mode='txt' requires extension= (e.g. 'txt', 'fac')")

    extension = extension.lstrip(".")
    timestamp = datetime.now(TIMEZONE)

    # base name used for staging + default target name
    base_name = (
        staging_name
        or (target_file_name.rsplit(".", 1)[0] if target_file_name else None)
        or (source_file.rsplit(".", 1)[0] if source_file else "dataframe_export")
    )
    staging_name = staging_name or f"{base_name}_updates"

    # final file name on SharePoint
    if target_file_name:
        target_base = target_file_name.rsplit(".", 1)[0] if target_file_name.endswith(f".{extension}") else target_file_name
    else:
        target_base = base_name
    if add_timestamp:
        target_base = f"{target_base}_{timestamp.strftime(timestamp_format)}"
    final_name = f"{target_base}.{extension}"

    # land the file in a dated subfolder, e.g. test/my-new-folder/2026-11-09/
    target_folder = target_folder.strip("/")
    if dated_folder:
        target_folder = f"{target_folder}/{timestamp.strftime(date_folder_format)}"
    target_folder = target_folder + "/"

    # ------------------------- 1. read -------------------------
    if mode != "dataframe":
        data = _read_source(mode, source_layer, source_folder, source_file, extension, csv_options)
    if show_preview:
        display(data)  # noqa: F821  (display exists in Synapse notebooks)

    # ------------------------- 2. stage -------------------------
    _write_to_sharepoint_layer(mode, data, staging_folder, staging_name, extension, csv_options, txt_options)

    # ------------------------- 3. publish -------------------------
    staged_path = f"{staging_folder}/{staging_name}/{staging_name}.{extension}"
    sp.publish_file_to_sharepoint(
        file_path=staged_path,
        target_folder=target_folder,
        target_file_name=final_name,
        confidentiality=confidentiality,
        pii_flag=pii_flag,
        description=description or f"Data refresh at {format_date_nicely(timestamp)}",
        sharepoint_site_path=sharepoint_site_path,
    )

    result = {
        "mode": mode,
        "source": f"{source_layer}/{source_folder}/{source_file}" if mode != "dataframe" else "in-memory DataFrame",
        "staged_path": staged_path,
        "sharepoint_site": sharepoint_site_path,
        "sharepoint_path": f"{target_folder}{final_name}",
        "published_at": timestamp.isoformat(),
    }
    print(f"✅ Published {result['source']} -> {sharepoint_site_path}/{result['sharepoint_path']}")
    return result


