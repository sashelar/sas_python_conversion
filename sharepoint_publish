from typing import Union


def format_date_nicely(dt: Union[datetime, None] = None) -> str:
    """
    Format a datetime object into a human-readable string with ordinal suffixes.

    Args:
        dt (datetime, optional): Datetime object to format. Defaults to current UTC time if None.

    Returns:
        str: Formatted date string in the format "Weekday Dayth of Month Year"
             (e.g., "Friday 17th of September 2026").

    Raises:
        ValueError: If the input is not a datetime object or None.

    Examples:
        >>> from datetime import datetime
        >>> format_date_nicely(datetime(2026, 9, 17))
        'Friday 17th of September 2026'
        >>> format_date_nicely()  # Uses current time
        'Monday 20th of May 2024'
    """
    if dt is None:
        dt = datetime.now()
    elif not isinstance(dt, datetime):
        raise ValueError("Input must be a datetime object or None")

    def _get_ordinal_suffix(day: int) -> str:
        """Return the ordinal suffix for a given day (e.g., 1 -> 'st', 2 -> 'nd')."""
        if 11 <= day <= 13:  # Special case for 11th-13th
            return "th"
        return {1: "st", 2: "nd", 3: "rd"}.get(day % 10, "th")

    return f"{dt.strftime('%A')} {dt.day}{_get_ordinal_suffix(dt.day)} " f"of {dt.strftime('%B')} {dt.year}"



