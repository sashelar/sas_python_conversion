# Example: Compare two DataFrames from ADLS
def quick_compare_example():
    """
    Quick example showing how to use the DataFrameComparator
    Replace the paths with your actual ADLS paths
    """
    
    # Load your data from ADLS
    # df1 = spark.read.parquet("abfss://container@storage.dfs.core.windows.net/path/to/data1.parquet")
    # df2 = spark.read.parquet("abfss://container@storage.dfs.core.windows.net/path/to/data2.parquet")
    
    # For demo purposes, create sample data
    from pyspark.sql import Row
    
    data1 = [
        Row(id="D10", name="John Doe", age=30, salary=50000.50),
        Row(id="D20", name="Jane Smith", age=25, salary=55000.75),
        Row(id="N30", name="Bob Johnson", age=35, salary=60000.00)
    ]
    
    data2 = [
        Row(id="D10", name="John Doe", age=30, salary=50000.51),  # Decimal change
        Row(id="D20", name="Jane Smyth", age=25, salary=55000.75),  # Typo
        Row(id="N30", name="Bob Johnson", age=36, salary=60000.00)  # Age changed
    ]
    
    df1 = spark.createDataFrame(data1)
    df2 = spark.createDataFrame(data2)
    
    # Run comparison
    comparator = DataFrameComparator(
        spark=spark,
        df1=df1,
        df2=df2,
        key_columns=['id'],
        numeric_precision=2,
        fuzzy_threshold=0.85
    )
    
    report = comparator.compare()
    
    # Show detailed report
    print("\n" + comparator.get_detailed_report())
    
    # Optionally save to ADLS
    # comparator.save_report_to_json("abfss://container@storage.dfs.core.windows.net/reports/comparison.json")
    
    return report

