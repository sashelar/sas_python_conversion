def _profile_dataframe(self, df: DataFrame, df_name: str) -> Dict:
    """
    Profile a DataFrame to detect nulls, duplicates, and data quality issues
    
    Parameters:
    -----------
    df : DataFrame
        DataFrame to profile
    df_name : str
        Name for reporting (e.g., 'df1' or 'df2')
        
    Returns:
    --------
    Dict with profiling results
    """
    print(f"\n📊 Profiling {df_name}...")
    
    total_rows = df.count()
    total_cols = len(df.columns)
    
    # Analyze each column
    column_profiles = {}
    
    for col_name in df.columns:
        col_type = str(dict(df.dtypes).get(col_name, 'unknown'))
        
        # Null analysis
        null_count = df.filter(F.col(col_name).isNull()).count()
        null_percentage = round((null_count / total_rows * 100), 2) if total_rows > 0 else 0
        
        # Distinct values
        distinct_count = df.select(col_name).distinct().count()
        
        # Empty strings (for string columns)
        empty_count = 0
        if 'string' in col_type.lower():
            empty_count = df.filter(
                (F.col(col_name) == "") | 
                (F.trim(F.col(col_name)) == "")
            ).count()
        
        column_profiles[col_name] = {
            'data_type': col_type,
            'null_count': null_count,
            'null_percentage': null_percentage,
            'distinct_count': distinct_count,
            'empty_string_count': empty_count if 'string' in col_type.lower() else None,
            'has_quality_issues': null_count > 0 or empty_count > 0
        }
    
    # Duplicate row detection
    if self.key_columns:
        # Check duplicates based on key columns
        duplicate_count = df.groupBy(self.key_columns).count().filter(F.col("count") > 1).count()
    else:
        # Check for completely duplicate rows
        duplicate_count = total_rows - df.distinct().count()
    
    profile_summary = {
        'dataframe_name': df_name,
        'total_rows': total_rows,
        'total_columns': total_cols,
        'duplicate_rows': duplicate_count,
        'column_profiles': column_profiles,
        'columns_with_nulls': [col for col, prof in column_profiles.items() if prof['null_count'] > 0],
        'columns_with_empty_strings': [col for col, prof in column_profiles.items() 
                                       if prof.get('empty_string_count', 0) > 0]
    }
    
    # Print summary
    print(f"   Total Rows: {total_rows:,}")
    print(f"   Total Columns: {total_cols}")
    print(f"   Duplicate Rows: {duplicate_count:,}")
    
    if profile_summary['columns_with_nulls']:
        print(f"   ⚠️  Columns with NULLs: {len(profile_summary['columns_with_nulls'])}")
        for col in profile_summary['columns_with_nulls'][:5]:  # Show first 5
            null_pct = column_profiles[col]['null_percentage']
            print(f"      - {col}: {null_pct}% null")
    
    if profile_summary['columns_with_empty_strings']:
        print(f"   ⚠️  Columns with empty strings: {len(profile_summary['columns_with_empty_strings'])}")
    
    return profile_summary


