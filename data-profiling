def compare(self) -> Dict:
    """Execute complete comparison and return detailed report"""
    print("=" * 80)
    print("DATAFRAME COMPARISON STARTED")
    print("=" * 80)
    
    # NEW: Add profiling step
    self.report['df1_profile'] = self._profile_dataframe(self.df1, 'DataFrame 1')
    self.report['df2_profile'] = self._profile_dataframe(self.df2, 'DataFrame 2')
    
    # Existing comparison steps
    self._compare_row_counts()
    self._compare_columns()
    self._compare_schema()
    
    if self.report.get('columns_match', False):
        self._compare_data()
    else:
        print("\n⚠️  Skipping data comparison due to column mismatch")
        self.report['data_comparison'] = {
            'status': 'SKIPPED',
            'reason': 'Column names do not match'
        }
    
    self._generate_final_report()
    return self.report


# ========================================================================
# UPDATE get_detailed_report() - Add profiling section
# ========================================================================

def get_detailed_report(self) -> str:
    """Generate a detailed text report"""
    lines = []
    lines.append("=" * 100)
    lines.append("DATAFRAME COMPARISON DETAILED REPORT")
    lines.append("=" * 100)
    lines.append(f"\nGenerated: {self.report.get('comparison_timestamp', 'N/A')}")
    lines.append(f"Overall Match: {'✓ PASS' if self.report.get('overall_match', False) else '✗ FAIL'}")
    
    # NEW: Data Quality Profile Section
    lines.append("\n" + "-" * 100)
    lines.append("DATA QUALITY PROFILE")
    lines.append("-" * 100)
    
    for df_key in ['df1_profile', 'df2_profile']:
        if df_key in self.report:
            profile = self.report[df_key]
            lines.append(f"\n{profile['dataframe_name']}:")
            lines.append(f"  Total Rows: {profile['total_rows']:,}")
            lines.append(f"  Total Columns: {profile['total_columns']}")
            lines.append(f"  Duplicate Rows: {profile['duplicate_rows']:,}")
            
            if profile['columns_with_nulls']:
                lines.append(f"  Columns with NULLs: {len(profile['columns_with_nulls'])}")
                for col in profile['columns_with_nulls'][:5]:
                    col_prof = profile['column_profiles'][col]
                    lines.append(f"    - {col}: {col_prof['null_count']:,} nulls ({col_prof['null_percentage']}%)")
    
    # Existing report sections...
    # (keep all your existing row count, column, schema, data comparison sections)
    
    lines.append("\n" + "=" * 100)
    return "\n".join(lines)


