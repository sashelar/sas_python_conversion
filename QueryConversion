# =========================================================================
# Spark SQL equivalent of the SAS AssetDBEntry_inclBGAAP logic
# Three separate views, one per SAS block, in the same order as the SAS.
#
# ASSUMPTIONS — please verify:
#   - Annex_21's SAS name-literal columns are referenced with backticks
#     exactly as written in the SAS. Change only the backtick-quoted
#     names if your real column names differ.
#   - "source in ('GPMS')" in each join filters the *joined* table's
#     source column (b.source / c.source / d.source), not a.source.
#   - Quantity_accounting, source, assets_agr, accounting_value_IFRS,
#     Solvency_II_value, Transparancy_Percentage, accrued all come from
#     table `a` (TMP_ADB.REP_ENTRY_...).
# =========================================================================

THISRUN_REPORTING_DATE_NUM = "20260331"
THISRUN_OUT_ROOT_PATH = "abfss://container@account.dfs.core.windows.net/path"
THISRUN_CONTEXT_ID = "CTX001"

# -------------------------------------------------------------------------
# Make the source tables queryable by name in SQL.
# Skip this if they're already catalog tables/views in your Synapse Spark
# metastore — just use their real names directly in the FROM/JOIN below.
# -------------------------------------------------------------------------
spark.table(f"TMP_ADB.REP_ENTRY_{THISRUN_REPORTING_DATE_NUM}").createOrReplaceTempView("a_src")
spark.table("Annex_21").createOrReplaceTempView("Annex_21")
spark.table("BS_Capline").createOrReplaceTempView("BS_Capline")
spark.table("BS_Interfinance").createOrReplaceTempView("BS_Interfinance")


# =========================================================================
# STEP 1 — literal translation of:
#   create table AssetDBEntry_inclBGAAP as
#   select a.*, count(a.buy_transaction_code) as cnt, coalesce(...), coalesce(...)
#   from ... left outer join ... left outer join ... left outer join ...
#   group by a.buy_transaction_code;
#
# In SAS proc sql, count(...) alongside a.* with GROUP BY does not
# collapse rows — it remerges the aggregate onto every detail row.
# COUNT(...) OVER (PARTITION BY ...) is the literal equivalent of that
# behaviour, not a substitute for it.
# =========================================================================

spark.sql("""
CREATE OR REPLACE TEMP VIEW AssetDBEntry_inclBGAAP AS
SELECT
    a.*,
    COUNT(a.Buy_Transaction_Code) OVER (PARTITION BY a.Buy_Transaction_Code) AS cnt,
    COALESCE(b.`A Accounting Value acc excl FVA`,
             c.Accounting_Value_BGAAP,
             d.Accounting_Value_BGAAP) AS accounting_value_BGAAP,
    COALESCE(b.`P Accrued Interest End - No Tota`,
             c.Accrued,
             d.Accrued) AS Accrued_BGAAP
FROM a_src a
LEFT JOIN Annex_21 b
    ON a.Buy_Transaction_Code = b.`A Buy Transaction`
    AND b.source = 'GPMS'
LEFT JOIN BS_Capline c
    ON a.Buy_Transaction_Code = c.Buy_Transaction_Code
    AND c.source = 'GPMS'
LEFT JOIN BS_Interfinance d
    ON a.Buy_Transaction_Code = d.Buy_Transaction_Code
    AND d.source = 'GPMS'
""")


# =========================================================================
# STEP 2 — literal translation of:
#   /*Eliminate duplicates by Buy_transaction_code*/
#   data AssetDBEntry_inclBGAAP (drop=cnt);
#   set AssetDBEntry_inclBGAAP;
#   if cnt = 1 or cnt = 0 or (cnt = 2 and Quantity_accounting ne 0) then output;
# =========================================================================

spark.sql("""
CREATE OR REPLACE TEMP VIEW AssetDBEntry_inclBGAAP_dedup AS
SELECT *
FROM AssetDBEntry_inclBGAAP
WHERE cnt = 1
   OR cnt = 0
   OR (cnt = 2 AND Quantity_accounting <> 0)
""")

# drop=cnt — Spark SQL has no "SELECT * EXCEPT(col)" guaranteed available
# on every Synapse runtime, so the column list is built once in Python
# and fed into a normal SQL SELECT (the only non-literal part of this
# script — needed because plain SQL can't reference "all columns minus
# these two" without naming the rest).
dedup_cols = [c for c in spark.table("AssetDBEntry_inclBGAAP_dedup").columns if c != "cnt"]
dedup_cols_sql = ", ".join(dedup_cols)

spark.sql(f"""
CREATE OR REPLACE TEMP VIEW AssetDBEntry_inclBGAAP_dedup AS
SELECT {dedup_cols_sql}
FROM AssetDBEntry_inclBGAAP_dedup
""")


# =========================================================================
# STEP 3 — literal translation of:
#   /*Forcing value for source different than GPMS*/
#   data AssetDBEntry_inclBGAAP_enriched;
#   set AssetDBEntry_inclBGAAP;
#   if missing(accounting_value_BGAAP) and source ne 'GPMS' then do;
#       if lowcase(substr(assets_agr,1,5)) ne "fvoci" then do;
#           accounting_value_BGAAP = accounting_value_IFRS;
#       end;
#       market_value_model = Solvency_II_value / Transparancy_Percentage;
#       flg = 1;
#   end;
#   if missing(accrued_BGAAP) and source ne 'GPMS' then do;
#       accrued_BGAAP = accrued;
#   end;
#
# Same column-list note as Step 2: accounting_value_BGAAP and
# Accrued_BGAAP are being overwritten, so they're excluded from the
# carried-forward column list and redefined explicitly via CASE below.
# =========================================================================

enriched_other_cols = [
    c for c in spark.table("AssetDBEntry_inclBGAAP_dedup").columns
    if c not in ("accounting_value_BGAAP", "Accrued_BGAAP")
]
enriched_other_cols_sql = ", ".join(enriched_other_cols)

spark.sql(f"""
CREATE OR REPLACE TEMP VIEW AssetDBEntry_inclBGAAP_enriched AS
SELECT
    {enriched_other_cols_sql},
    CASE
        WHEN accounting_value_BGAAP IS NULL
             AND source <> 'GPMS'
             AND LOWER(SUBSTRING(assets_agr, 1, 5)) <> 'fvoci'
        THEN accounting_value_IFRS
        ELSE accounting_value_BGAAP
    END AS accounting_value_BGAAP,
    CASE
        WHEN accounting_value_BGAAP IS NULL AND source <> 'GPMS'
        THEN Solvency_II_value / Transparancy_Percentage
    END AS market_value_model,
    CASE
        WHEN accounting_value_BGAAP IS NULL AND source <> 'GPMS'
        THEN 1
    END AS flg,
    CASE
        WHEN Accrued_BGAAP IS NULL AND source <> 'GPMS'
        THEN accrued
        ELSE Accrued_BGAAP
    END AS Accrued_BGAAP
FROM AssetDBEntry_inclBGAAP_dedup
""")


# =========================================================================
# STEP 4 — literal translation of:
#   PROC EXPORT DATA = AssetDBEntry_inclBGAAP_enriched (where=(flg = 1))
#   OUTFILE = "..." DBMS = XLSX REPLACE;
# =========================================================================

forced_changes = spark.sql("""
SELECT *
FROM AssetDBEntry_inclBGAAP_enriched
WHERE flg = 1
""")

import os

local_tmp_path = f"/tmp/BGAAP_{THISRUN_REPORTING_DATE_NUM}.xlsx"
output_dir = f"{THISRUN_OUT_ROOT_PATH}/Output/BGAAP/Forced_Changes/{THISRUN_CONTEXT_ID}"
output_file = f"{output_dir}/BGAAP_{THISRUN_REPORTING_DATE_NUM}.xlsx"

pdf = forced_changes.toPandas()
pdf.to_excel(local_tmp_path, index=False, engine="openpyxl")

mssparkutils.fs.mkdirs(output_dir)
mssparkutils.fs.cp(f"file:{local_tmp_path}", output_file, True)  # True = overwrite, like REPLACE
os.remove(local_tmp_path)

print("Forced changes exported to:", output_file)
