# =========================================================================
# PySpark equivalent of the SAS AssetDBEntry_inclBGAAP logic
# Intended for an Azure Synapse Spark notebook
#
# ASSUMPTIONS (please verify against your real schemas before running):
#   - The SAS name-literals (e.g. b.'A Accounting Value acc excl FVA'n) are
#     actual column names containing spaces/punctuation in Annex_21. They
#     are renamed below to underscore-safe names right after reading.
#     Update the renames to match your real column names.
#   - The "source in ('GPMS')" filter in each join condition refers to the
#     `source` column of the table being joined (b/c/d), not of `a`.
#     Adjust if it's actually a.source.
#   - Quantity_accounting, source, assets_agr, accounting_value_IFRS,
#     Solvency_II_value, Transparancy_Percentage and accrued all live on
#     table `a` (they survive via a.*).
#   - Parameters THISRUN_REPORTING_DATE_NUM / THISRUN_OUT_ROOT_PATH /
#     THISRUN_CONTEXT_ID are passed in as notebook parameters (e.g. from a
#     Synapse pipeline) — set them in the first cell.
# =========================================================================

from pyspark.sql import functions as F
from pyspark.sql.window import Window

# -------------------------------------------------------------------------
# Notebook parameters (mark this cell as a "Parameters" cell if used in a
# pipeline, same role as the SAS macro variables &THISRUN_...)
# -------------------------------------------------------------------------
THISRUN_REPORTING_DATE_NUM = "20260331"   # e.g. yyyymmdd
THISRUN_OUT_ROOT_PATH = "abfss://container@account.dfs.core.windows.net/path"
THISRUN_CONTEXT_ID = "CTX001"


# =========================================================================
# STEP 1  (was: create table AssetDBEntry_inclBGAAP as select ... group by)
#
# NOTE on the SAS quirk being replicated here:
#   SAS PROC SQL allows count(a.buy_transaction_code) alongside select a.*
#   with a GROUP BY — it does NOT collapse rows. It "remerges" the
#   aggregate back onto every detail row. That is exactly the behaviour of
#   a window function, so we use count(...).over(Window.partitionBy(...))
#   instead of a real groupBy().agg() (which would collapse rows).
# =========================================================================

a = spark.table(f"TMP_ADB.REP_ENTRY_{THISRUN_REPORTING_DATE_NUM}")
b = spark.table("Annex_21")
c = spark.table("BS_Capline")
d = spark.table("BS_Interfinance")

# Rename SAS name-literal columns in Annex_21 to plain identifiers.
# >>> Update these to the exact source column names in your environment. <<<
b = (
    b.withColumnRenamed("A Accounting Value acc excl FVA", "acct_val_excl_FVA")
     .withColumnRenamed("P Accrued Interest End - No Tota", "accrued_interest_no_tota")
     .withColumnRenamed("A Buy Transaction", "buy_transaction")
)

joined = (
    a.alias("a")
    .join(
        b.alias("b"),
        on=(F.col("a.Buy_Transaction_Code") == F.col("b.buy_transaction"))
        & (F.col("b.source") == "GPMS"),
        how="left",
    )
    .join(
        c.alias("c"),
        on=(F.col("a.Buy_Transaction_Code") == F.col("c.Buy_Transaction_Code"))
        & (F.col("c.source") == "GPMS"),
        how="left",
    )
    .join(
        d.alias("d"),
        on=(F.col("a.Buy_Transaction_Code") == F.col("d.Buy_Transaction_Code"))
        & (F.col("d.source") == "GPMS"),
        how="left",
    )
)

# cnt = count(a.buy_transaction_code) "grouped" but remerged onto every row
win_by_key = Window.partitionBy("a.Buy_Transaction_Code")
joined = joined.withColumn("cnt", F.count(F.col("a.Buy_Transaction_Code")).over(win_by_key))

asset_db_entry_inclBGAAP = joined.select(
    "a.*",
    "cnt",
    F.coalesce(
        F.col("b.acct_val_excl_FVA"),
        F.col("c.Accounting_Value_BGAAP"),
        F.col("d.Accounting_Value_BGAAP"),
    ).alias("accounting_value_BGAAP"),
    F.coalesce(
        F.col("b.accrued_interest_no_tota"),
        F.col("c.Accrued"),
        F.col("d.Accrued"),
    ).alias("Accrued_BGAAP"),
)

asset_db_entry_inclBGAAP.cache()
print("Step 1 row count:", asset_db_entry_inclBGAAP.count())


# =========================================================================
# STEP 2  (was: /*Eliminate duplicates by Buy_transaction_code*/  data step)
# =========================================================================

asset_db_entry_inclBGAAP = (
    asset_db_entry_inclBGAAP.filter(
        (F.col("cnt") == 1)
        | (F.col("cnt") == 0)
        | ((F.col("cnt") == 2) & (F.col("Quantity_accounting") != 0))
    )
    .drop("cnt")
)


# =========================================================================
# STEP 3  (was: /*Forcing value for source different than GPMS*/ data step)
#
# NOTE: in the original SAS, market_value_model and flg are only assigned
# inside the OUTER if-block (they sit at the same indent level as the
# inner if, i.e. outside it but inside the outer do/end). For rows that
# don't satisfy the outer condition, these columns are left missing/null
# — reproduced below the same way with F.when(...).otherwise(F.lit(None)).
# =========================================================================

outer_cond = F.col("accounting_value_BGAAP").isNull() & (F.col("source") != "GPMS")
inner_cond = F.lower(F.substring(F.col("assets_agr"), 1, 5)) != "fvoci"
accrued_cond = F.col("Accrued_BGAAP").isNull() & (F.col("source") != "GPMS")

asset_db_entry_inclBGAAP_enriched = (
    asset_db_entry_inclBGAAP
    .withColumn(
        "accounting_value_BGAAP",
        F.when(outer_cond & inner_cond, F.col("accounting_value_IFRS"))
         .otherwise(F.col("accounting_value_BGAAP")),
    )
    .withColumn(
        "market_value_model",
        F.when(outer_cond, F.col("Solvency_II_value") / F.col("Transparancy_Percentage"))
         .otherwise(F.lit(None)),
    )
    .withColumn(
        "flg",
        F.when(outer_cond, F.lit(1)).otherwise(F.lit(None)),
    )
    .withColumn(
        "Accrued_BGAAP",
        F.when(accrued_cond, F.col("accrued")).otherwise(F.col("Accrued_BGAAP")),
    )
)


# =========================================================================
# STEP 4  (was: PROC EXPORT ... where=(flg=1) ... DBMS=XLSX)
#
# Spark has no native xlsx writer. Since this is a small "forced changes"
# export, the simplest approach in a Synapse notebook is to filter, bring
# the (small) result to the driver as pandas, and write it with openpyxl,
# then move it to ADLS with mssparkutils. If the forced-changes set could
# be large, swap to the spark-excel option commented below instead.
# =========================================================================

forced_changes = asset_db_entry_inclBGAAP_enriched.filter(F.col("flg") == 1)

# --- Option A: pandas/openpyxl (fine for small-to-medium result sets) ---
import os

local_tmp_path = f"/tmp/BGAAP_{THISRUN_REPORTING_DATE_NUM}.xlsx"
output_dir = f"{THISRUN_OUT_ROOT_PATH}/Output/BGAAP/Forced_Changes/{THISRUN_CONTEXT_ID}"
output_file = f"{output_dir}/BGAAP_{THISRUN_REPORTING_DATE_NUM}.xlsx"

pdf = forced_changes.toPandas()
pdf.to_excel(local_tmp_path, index=False, engine="openpyxl")

mssparkutils.fs.mkdirs(output_dir)
mssparkutils.fs.cp(f"file:{local_tmp_path}", output_file, True)  # True = overwrite, like REPLACE
os.remove(local_tmp_path)

print("Forced changes exported to:", output_file)

